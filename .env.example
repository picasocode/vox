# KIT VOX — environment variables
# Copy the ones you need into Vercel Project -> Settings -> Environment Variables,
# or into backend/.env for local runs. NEVER commit the real key file.

# --- College system API (required for live data; omit KIT_PARTICIPANT_KEY to run on mock data) ---
KIT_API_BASE_URL=https://ht.knowvally.com
KIT_PARTICIPANT_KEY=your-college-api-key
KIT_USE_MOCK=false

# --- Optional: force mock data even when a key is set (true/false) ---
# KIT_USE_MOCK=true

# --- Two-project deployment, API project only (see README.md) ---
# Skips the frontend build inside the API project:
# KIT_FRONTEND_BUILD=never

# --- Two-project deployment, Web project only (see README.md) ---
# Full URL of the deployed API project, no trailing slash, e.g.:
# VITE_API_BASE_URL=https://vox-api.vercel.app
# Optional: PostgreSQL (Neon / Vercel Postgres) for durable sessions & history.
# When set, the backend stores data there; when empty it uses local SQLite.
# In Vercel, set DATABASE_URL on the API project to the POOLED connection string.
# DATABASE_URL=postgresql://<user>:<password>@<host-pooler>/<db>?sslmode=require
