# backend/.env — local environment for the KIT VOX backend (not committed)
# Vercel deployments use Project -> Settings -> Environment Variables instead.

KIT_API_BASE_URL=https://ht.knowvally.com
KIT_PARTICIPANT_KEY=your-college-api-key
KIT_USE_MOCK=false

# Optional overrides:
# KIT_USE_MOCK=true            # run the whole app on built-in mock data
# KIT_DB_PATH=/tmp/kit_vox.db  # custom database location (Vercel sets /tmp automatically)
